# Copy to .env and fill in values (do not commit .env)
PORT=3000
CLOUD_API_KEY=change-me-fbf-key
DEFAULT_DEVICE_ID=esp32-01
# Must match SoftAP Settings → API key on the ESP
# DATA_DIR=./data
# SEED_DIR=./seed

# Web Push OS notifications (npx web-push generate-vapid-keys --json)
# Also set these on Render → Environment
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
